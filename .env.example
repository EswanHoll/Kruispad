# Names only — fill values locally from Bitwarden (never commit real values).
# Shared Supabase project + schema `kruispad` (ADR-0003).
# Hosted under GekkoFlow at /kruispad/ (ADR-0001) — no separate Vercel project.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — hydrate from BWS; never prefix with VITE_
SUPABASE_URL__SHARED=
SUPABASE_SERVICE_ROLE_KEY__SHARED=

# Reuse existing GekkoFlow / BWS SendGrid names (no new API key).
# Verified sender preference: noreply@gekkoflow.com (also: notifications@gekkotech.co.za).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@gekkoflow.com

APP_BASE_URL__PROJ_KRUISPAD=http://localhost:5173/kruispad

# Shared secret for POST /api/kruispad/notify (server→notify); browser uses Bearer JWT.
KRUISPAD_NOTIFY_SECRET__PROJ_KRUISPAD=
